# Real QSX-UF core (d=3 graph, LANES=8): watchdog bound, invalid-result masking, done protocol.
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 48

[engines]
smtbmc bitwuzla

[script]
read_verilog -sv -formal -I. qsx_min_tree.sv qsx_uf_core.sv core_formal.sv
prep -top core_formal

